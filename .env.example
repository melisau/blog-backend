# Yerel MongoDB kullanıyorsanız bu satır doğrudan çalışır.
# Atlas kullanıyorsanız değeri kendi bağlantı adresinizle değiştirin.
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=blog_db

# Gerçek ortamda uzun ve rastgele bir değer kullanın.
# Örnek üretim: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# İstek sayısı / pencere (saniye). Pozitif değerler kullanın.
# Sayaçlar MongoDB'de paylaşılır; sunucu yeniden başlatılsa da korunur.
WRITE_RATE_LIMIT=120
WRITE_RATE_WINDOW_SECONDS=60
LOGIN_RATE_LIMIT=10
LOGIN_RATE_WINDOW_SECONDS=60
LOGIN_ACCOUNT_RATE_LIMIT=10
LOGIN_ACCOUNT_RATE_WINDOW_SECONDS=300
REGISTER_RATE_LIMIT=10
REGISTER_RATE_WINDOW_SECONDS=3600
BLOG_RATE_LIMIT=10
BLOG_RATE_WINDOW_SECONDS=60
COMMENT_RATE_LIMIT=20
COMMENT_RATE_WINDOW_SECONDS=60

UPLOAD_DIR=uploads
MAX_IMAGE_SIZE_MB=5
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

# Sağlık kategorileri ve örnek içerikleri yükleyen seed betiği için kullanılır.
# Bu bilgileri yalnızca yerel geliştirme hesabı olarak değerlendirin.
SEED_EDITOR_USERNAME=fitbook_saglik
SEED_EDITOR_EMAIL=saglik@fitbook.example
SEED_EDITOR_PASSWORD=replace-with-a-local-development-password

